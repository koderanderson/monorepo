FROM php:8.3-fpm-alpine

# libzip: runtime (.so) for ext-zip; libzip-dev only during compile.
RUN apk add --no-cache icu-libs libzip \
    && apk add --no-cache --virtual .build-deps \
        $PHPIZE_DEPS \
        icu-dev \
        libzip-dev \
    && docker-php-ext-configure intl \
    && docker-php-ext-install -j"$(nproc)" intl opcache pdo_mysql zip \
    && apk del .build-deps \
    && apk add --no-cache bash curl git unzip \
    && curl -fsSL https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer

COPY docker-entrypoint-api.sh /usr/local/bin/docker-entrypoint-api.sh
RUN chmod +x /usr/local/bin/docker-entrypoint-api.sh

WORKDIR /var/www/html

ENTRYPOINT ["docker-entrypoint-api.sh"]
CMD ["php-fpm"]
